<h1>Edit Customer</h1>

<form method="post" action="/clients/<%= @client.id %>" class="form">
  <div class="field">
    <label for="name">Customer name *</label>
    <input type="text" id="name" name="name" value="<%= h(@client.name) %>" required autofocus>
  </div>
  <div class="field">
    <label for="email">Email</label>
    <input type="email" id="email" name="email" value="<%= h(@client.email) %>">
  </div>
  <div class="field">
    <label for="gstin">GSTIN</label>
    <input type="text" id="gstin" name="gstin" value="<%= h(@client.gstin) %>" placeholder="27AAAAA0000A1Z5">
  </div>
  <div class="field">
    <label for="state">State</label>
    <input type="text" id="state" name="state" value="<%= h(@client.state) %>" placeholder="Maharashtra">
  </div>
  <div class="field">
    <label for="address">Address</label>
    <input type="text" id="address" name="address" value="<%= h(@client.address) %>">
  </div>
  <div class="field">
    <label for="city">City</label>
    <input type="text" id="city" name="city" value="<%= h(@client.city) %>">
  </div>
  <div class="field">
    <label for="pincode">Pincode</label>
    <input type="text" id="pincode" name="pincode" value="<%= h(@client.pincode) %>" placeholder="400001">
  </div>
  <div class="actions">
    <button type="submit">Save Customer</button>
    <a class="button" href="/clients/<%= @client.id %>">Cancel</a>
  </div>
</form>