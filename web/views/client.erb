<%# Customer page: summary cards, payment/expense tables and credit flow. %>
<% balance = @client.available_credit - @client.total_debits %>

<h1><%= h(@client.name) %> <a class="muted" style="font-size: 0.5em; text-decoration: none;" href="/clients">← Back to Clients</a></h1>
<% if @client.email %><p class="muted"><%= h(@client.email) %></p><% end %>

<div style="margin-bottom: 20px;">
  <a class="button" href="/clients/<%= @client.id %>/export">Download Statement (CSV)</a>
</div>

<div class="cards">

  <div class="card">
    <div class="card-label">Available Credit</div>
    <div class="card-value"><%= money(@client.available_credit) %></div>
  </div>
  <div class="card">
    <div class="card-label">Total Debits</div>
    <div class="card-value"><%= money(@client.total_debits) %></div>
  </div>
  <div class="card">
    <div class="card-label">Balance</div>
    <div class="card-value"><%= money(balance) %></div>
  </div>
  <div class="card">
    <div class="card-label">Orders</div>
    <div class="card-value"><%= @client_orders.size %></div>
  </div>
</div>

<div style="margin: 20px 0;">
  <a class="button" href="<%= record_payment_href(@client) %>">Record payment for <%= h(@client.name) %></a>
</div>

<h2>Payments (Income)</h2>

<% if @client.credits.empty? %>
  <p class="muted">No payments recorded.</p>
<% else %>
  <table class="data">
    <thead>
      <tr><th>#</th><th>Date</th><th>Amount</th><th>Mode</th><th>Note</th></tr>
    </thead>
    <tbody>
      <% @client.credits.each_with_index do |credit, i| %>
        <tr>
          <td><%= i + 1 %></td>
          <td><%= fmt_date(credit.date) %></td>
          <td class="num positive"><%= money(credit.amount) %></td>
          <td><%= h(credit.mode.to_s) %></td>
          <td><%= h(credit.note.to_s) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>

<h2>Expenses (Debits)</h2>
<% if @client.debits.empty? %>
  <p class="muted">No expenses recorded.</p>
<% else %>
  <table class="data">
    <thead>
      <tr><th>#</th><th>Date</th><th>Amount</th><th>Mode</th><th>Note</th></tr>
    </thead>
    <tbody>
      <% @client.debits.each_with_index do |debit, i| %>
        <tr>
          <td><%= i + 1 %></td>
          <td><%= fmt_date(debit.date) %></td>
          <td class="num negative"><%= money(debit.amount) %></td>
          <td><%= h(debit.mode.to_s) %></td>
          <td><%= h(debit.note.to_s) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>

<h2>Orders</h2>
<% if @credit_flow.empty? %>
  <p class="muted">No orders for this customer yet.</p>
<% else %>
  <table class="data wide">
    <thead>
      <tr>
        <th>ID</th>
        <th>Date</th>
        <th>Total</th>
        <th>Balance Due</th>
        <th>Credit Flow</th>
      </tr>
    </thead>
    <tbody>
      <% @credit_flow.each do |entry| %>
        <tr style="cursor: pointer;" onclick="window.location='/orders/<%= entry[:order].id %>'">
          <td><%= entry[:order].order_id %></td>
          <td><%= fmt_date(entry[:order].date) %></td>
          <td class="num"><%= money(entry[:order].total) %></td>
          <td class="num <%= "negative" if entry[:balance_due].positive? %>">
            <%= money(entry[:balance_due]) %>
            <% if entry[:balance_due].positive? %>
              <span style="font-size: 0.7em; padding: 2px 4px; background: #fee2e2; color: #b91c1c; border-radius: 4px; margin-left: 5px;">Due</span>
            <% else %>
              <span style="font-size: 0.7em; padding: 2px 4px; background: #dcfce7; color: #15803d; border-radius: 4px; margin-left: 5px;">Paid</span>
            <% end %>
          </td>

          <td class="muted" style="font-size: 0.9em;">
            <%= money(entry[:credit_before]) %> → <%= money(entry[:credit_after]) %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>